{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle/minecraft-versions/.*\\.properties$/"],
      "matchStrings": [
        "architectury_api_version=(?<currentValue>[^\\n\\r]+)"
      ],
      "depNameTemplate": "dev.architectury:architectury-fabric",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.architectury.dev/"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle/minecraft-versions/.*\\.properties$/"],
      "matchStrings": [
        "fabric_loader_version=(?<currentValue>[^\\n\\r]+)"
      ],
      "depNameTemplate": "net.fabricmc:fabric-loader",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.fabricmc.net/"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle/minecraft-versions/.*\\.properties$/"],
      "matchStrings": [
        "fabric_api_version=(?<currentValue>[^\\n\\r]+)"
      ],
      "depNameTemplate": "net.fabricmc.fabric-api:fabric-api",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.fabricmc.net/"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^gradle/minecraft-versions/.*\\.properties$/"],
      "matchStrings": [
        "neoforge_version=(?<currentValue>[^\\n\\r]+)"
      ],
      "depNameTemplate": "net.neoforged:neoforge",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.neoforged.net/releases/"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "all dependencies"
    },
    {
      "matchFileNames": ["gradle/minecraft-versions/**"],
      "enabled": false
    },
    {
      "matchFileNames": ["gradle/minecraft-versions/26.2.properties"],
      "enabled": true,
      "groupName": "latest Minecraft dependencies"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle tooling"
    }
  ],
  "timezone": "Asia/Seoul",
  "schedule": ["* 18-23 1,15 * *"]
}
